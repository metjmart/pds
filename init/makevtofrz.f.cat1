
	subroutine makevofrz(vofrz,vbar,z,nr,nz,dr,f)

	integer :: nr,nz
	real, dimension(nr,nz) :: vofrz(nr,nz)
	real, dimension(nr) :: vbar(nr) 
	real, diimension(nz) :: z
	real :: dr,f

	integer :: i,j
	real :: ztop,zhere,fac,gamma,r

	gamma=1.0

	ztop = 16000.0

	call makevbar(vbar,nr,dr)

	do j=1,nz

	  zhere=z(j)

	  do i=1,nr
	 
	    r=i*dr

	
c	  Include next line for vertically aligned profile
c	    gamma=0.0


	    fac = exp(-((1.7*abs(zhere)/ztop)**2.0)) * 
     &		(1.0 - gamma*exp(-((r/(1000 + 4.0*abs(zhere))))**2.7))

c	  if lowest level is below the ground, choose fac so 
c	  that velocity field is correct at the surface 
c	  by linear interpolation.
	    if (zhere.lt.0.0) then
              fac = 2.0 - fac	
	    end if

c	    if (zhere.gt.ztop) fac=0.0

c	  Include next line to make barotropic vortex
c	    fac=1.0

	    vofrz(i,j) = fac*vbar(i)

	  end do
	end do  

	return
	end	  



